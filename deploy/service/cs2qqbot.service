# CS2 饰品行情 QQ 机器人 - systemd 服务
# 安装: sudo cp deploy/service/cs2qqbot.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now cs2qqbot

[Unit]
Description=CS2 Skin Market QQ Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 请将 /opt/cs2-qq-bot 替换为实际部署路径
WorkingDirectory=/opt/cs2-qq-bot
ExecStart=/opt/cs2-qq-bot/.venv/bin/python main.py
Restart=always
RestartSec=10
# 崩溃自动重启，保证 7x24 小时运行
StartLimitIntervalSec=0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
