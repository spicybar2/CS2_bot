# 统一换行:源码 LF,Windows 脚本 CRLF(否则 cmd 解析 .bat 会出问题)
* text=auto eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

# 二进制,不做换行转换
*.db    binary
*.db-wal binary
*.db-shm binary
*.png   binary
*.jpg   binary
*.mp4   binary
*.zip   binary
